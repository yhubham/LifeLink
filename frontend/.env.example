# LifeLink frontend configuration
#
# API requests are same-origin under /api/v1:
#   - deployed: Vercel routes /api/* to the FastAPI service (vercel.json)
#   - locally:  the Vite dev server proxies /api (and WebSocket upgrades)
#               to http://127.0.0.1:8000 (vite.config.js)
#
# Leave VITE_API_URL unset for both of the above. Set it only when pointing
# the app at a completely different backend.
# VITE_API_URL=http://127.0.0.1:8000/api/v1
