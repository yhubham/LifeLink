APP_NAME=LifeLink
DEBUG=true

DATABASE_URL=postgresql+psycopg://lifelink_user:lifelink_dev_password@localhost:5433/lifelink

# Use a long random value in any shared deployment.
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:5173

# --- Public hospital discovery (Geoapify Places API) ----------------------
# Keep the key server-side only. Never put it in a React/Vite environment.
GEOAPIFY_API_URL=https://api.geoapify.com/v2/places
GEOAPIFY_API_KEY=replace-with-your-geoapify-key
GEOAPIFY_TIMEOUT_SECONDS=10
GEOAPIFY_CACHE_SECONDS=120
GEOAPIFY_CATEGORY=healthcare.hospital
HOSPITAL_DISCOVERY_RADIUS_M=5000
HOSPITAL_DISCOVERY_LIMIT=50

# --- Secure tickets / private incident media ------------------------------
TICKET_TOKEN_EXPIRE_MINUTES=1440
MEDIA_STORAGE_DIR=storage/incidents
MEDIA_MAX_BYTES=10485760
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# --- WebRTC voice (voice-only, nothing is recorded) ----------------------
STUN_URLS=stun:stun.l.google.com:19302

# Option A: static TURN credentials (development only).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Option B (recommended): coturn REST API shared secret. The API mints
# short-lived per-user credentials, so no static TURN password reaches a browser.
TURN_SECRET=
TURN_TTL_SECONDS=3600
